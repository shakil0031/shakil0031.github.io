---
import '../styles/global.css';
import { themeCss } from '../config/theme';
import { profile } from '../data/profile';

interface Props { title?: string; description?: string }
const {
  title = `${profile.name}, ${profile.role}`,
  description = `${profile.name} is a ${profile.role.toLowerCase()} ${profile.tagline}.`,
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400..800&family=Geist:wght@400..600&display=swap" />
    <style is:global set:html={themeCss()}></style>
    <!-- Re-apply the visitor's saved dark/light choice before first paint (no flash). -->
    <script is:inline>
      try {
        const m = localStorage.getItem('mode');
        if (m === 'dark' || m === 'light') document.documentElement.dataset.mode = m;
      } catch {}
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
